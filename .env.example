# Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=n8n_mvp
POSTGRES_PORT=5432

# Backend Configuration
NODE_ENV=production
BACKEND_PORT=3001
JWT_SECRET=change-me-in-production-use-strong-random-secret

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001

# Database Type (sqlite or postgres)
# For Docker, use 'postgres'
# For local development, use 'sqlite'
DATABASE_TYPE=postgres

# Database URL (for PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@db:5432/n8n_mvp

# Database Path (for SQLite - only used when DATABASE_TYPE=sqlite)
# DATABASE_PATH=./packages/backend/data/n8n-mvp.db
